{
  "name": "naritai-db-sp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && cf build",
    "deploy": "cf deploy --prebuilt --mode production",
    "check:deploy": "cf deploy --prebuilt --mode production --dry-run",
    "preview": "vite preview --port 4174",
    "check:morning": "node scripts/check-morning.mjs",
    "check:archive": "node scripts/check-archive.mjs && node scripts/check-scores.mjs && node scripts/check-past-papers.mjs && node scripts/check-legacy-exercises.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "cf": "1.0.0-beta.32",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
